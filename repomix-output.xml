```bash
# Install PostgreSQL via Docker
docker run -d \
  --name postgres \
  -p 5432:5432 \
  -e POSTGRES_DB=intellirag \
  -e POSTGRES_USER=intellirag_user \
  -e POSTGRES_PASSWORD=change_me_in_production \
