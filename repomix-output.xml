    def from_vault(cls, vault_url: str, vault_token: str) -> "Settings":
        """
        Load secrets from HashiCorp Vault.
        
        Example:
            settings = Settings.from_vault(
                vault_url="http://localhost:8200",
                vault_token="hvs.xxx"
            )
