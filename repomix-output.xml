                    await self.db.update_document_paths(
                        document['document_id'],
                        processed_path=processed_path
                    )
                    
                    # Step 3: Chunk text
                    await self.db.update_job_progress(job_id, 'chunking', 'in_progress')
                    chunks = await self.chunker.chunk_text(
                        parsed_content['text'],
