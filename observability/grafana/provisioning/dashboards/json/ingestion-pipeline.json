{
  "dashboard": {
    "title": "Ingestion Pipeline",
    "uid": "ingestion-pipeline",
    "tags": ["intellirag", "ingestion", "document-processing"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Ingestion Jobs by Status",
        "targets": [
          {
            "expr": "rate(ingestion_jobs_total{job=\"intellirag\"}[5m])",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 30,
              "stacking": {"mode": "normal"}
            },
            "unit": "ops"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "failed"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            },
            {
              "matcher": {"id": "byName", "options": "completed"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]
            },
            {
              "matcher": {"id": "byName", "options": "processing"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "yellow"}}]
            }
          ]
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "heatmap",
        "title": "File Upload Size Distribution",
        "targets": [
          {
            "expr": "rate(file_upload_size_bytes_bucket{job=\"intellirag\"}[5m])",
            "legendFormat": "{{le}}",
            "refId": "A",
            "format": "heatmap"
          }
        ],
        "options": {
          "calculate": true,
          "yAxis": {
            "unit": "decbytes"
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 10, "w": 16, "x": 0, "y": 8},
        "type": "table",
        "title": "Processing Stage Duration (Avg)",
        "targets": [
          {
            "expr": "avg by(stage) (rate(document_processing_stage_duration_seconds_sum{job=\"intellirag\"}[5m]) / rate(document_processing_stage_duration_seconds_count{job=\"intellirag\"}[5m]))",
            "format": "table",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "renameByName": {
                "stage": "Processing Stage",
                "Value": "Avg Duration (s)"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "fields": {},
              "sort": [{"field": "Avg Duration (s)", "desc": true}]
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "left"
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Avg Duration (s)"},
              "properties": [
                {"id": "unit", "value": "s"},
                {"id": "custom.cellOptions", "value": {"type": "color-background"}},
                {"id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    {"value": null, "color": "green"},
                    {"value": 1, "color": "yellow"},
                    {"value": 5, "color": "red"}
                  ]
                }}
              ]
            }
          ]
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 5, "w": 8, "x": 16, "y": 8},
        "type": "stat",
        "title": "Avg Chunks per Document",
        "targets": [
          {
            "expr": "rate(ingestion_chunks_created_sum{job=\"intellirag\"}[5m]) / rate(ingestion_chunks_created_count{job=\"intellirag\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 5, "w": 8, "x": 16, "y": 13},
        "type": "stat",
        "title": "Ingestion Errors (5m)",
        "targets": [
          {
            "expr": "increase(ingestion_errors_total{job=\"intellirag\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "none",
          "textMode": "value",
          "colorMode": "background"
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18},
        "type": "histogram",
        "title": "File Upload Duration Distribution",
        "targets": [
          {
            "expr": "rate(file_upload_duration_seconds_bucket{job=\"intellirag\"}[5m])",
            "legendFormat": "{{le}}s",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18},
        "type": "timeseries",
        "title": "Ingestion Job Duration (P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(ingestion_job_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P95 Duration",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 20
            },
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 30, "color": "yellow"},
                {"value": 60, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 26},
        "type": "table",
        "title": "Recent Ingestion Errors",
        "targets": [
          {
            "expr": "sum by(error_type, file_type) (increase(ingestion_errors_total{job=\"intellirag\"}[1h]))",
            "format": "table",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "renameByName": {
                "error_type": "Error Type",
                "file_type": "File Type",
                "Value": "Count (1h)"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "sort": [{"field": "Count (1h)", "desc": true}]
            }
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "job",
          "type": "constant",
          "current": {
            "value": "intellirag",
            "text": "intellirag"
          },
          "hide": 2
        }
      ]
    }
  }
}
