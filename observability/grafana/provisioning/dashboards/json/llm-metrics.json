{
  "dashboard": {
    "title": "LLM Metrics",
    "uid": "llm-metrics",
    "tags": ["intellirag", "llm", "vllm", "gpu", "cost"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Token Usage (Input vs Output)",
        "targets": [
          {
            "expr": "rate(llm_token_count_total{job=\"intellirag\",type=\"input\"}[5m])",
            "legendFormat": "Input Tokens/s",
            "refId": "A"
          },
          {
            "expr": "rate(llm_token_count_total{job=\"intellirag\",type=\"output\"}[5m])",
            "legendFormat": "Output Tokens/s",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 25,
              "stacking": {"mode": "none"}
            },
            "unit": "tps"
          }
        },
        "options": {
          "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
        "type": "gauge",
        "title": "GPU Utilization",
        "targets": [
          {
            "expr": "gpu_utilization_percent{job=\"intellirag\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
        "type": "stat",
        "title": "Total Tokens (24h)",
        "targets": [
          {
            "expr": "sum(increase(llm_token_count_total{job=\"intellirag\"}[24h]))",
            "legendFormat": "Total Tokens",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "type": "timeseries",
        "title": "LLM Request Rate",
        "targets": [
          {
            "expr": "rate(llm_token_count{job=\"intellirag\"}[5m])",
            "legendFormat": "{{type}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "type": "stat",
        "title": "Estimated Cost (24h)",
        "description": "Estimated cost based on Qwen2.5-7B pricing ($0.00015/1K input, $0.0006/1K output)",
        "targets": [
          {
            "expr": "(increase(llm_token_count{job=\"intellirag\",type=\"input\"}[24h]) * 0.00015 / 1000) + (increase(llm_token_count{job=\"intellirag\",type=\"output\"}[24h]) * 0.0006 / 1000)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 4,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 5, "color": "yellow"},
                {"value": 10, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "type": "stat",
        "title": "Avg Tokens per Request",
        "targets": [
          {
            "expr": "rate(llm_token_count{job=\"intellirag\",type=\"output\"}[5m]) / rate(http_requests_total{job=\"intellirag\",endpoint=\"/api/v1/query\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "timeseries",
        "title": "Token Generation Rate Trend",
        "targets": [
          {
            "expr": "rate(llm_token_count{job=\"intellirag\"}[5m])",
            "legendFormat": "{{type}} tokens/sec",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2,
              "fillOpacity": 10
            },
            "unit": "tps"
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "table",
        "title": "Token Usage Summary (Last Hour)",
        "targets": [
          {
            "expr": "sum by(type) (increase(llm_token_count{job=\"intellirag\"}[1h]))",
            "format": "table",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "renameByName": {
                "type": "Token Type",
                "Value": "Total Tokens"
              }
            }
          },
          {
            "id": "calculateField",
            "options": {
              "alias": "Cost (USD)",
              "mode": "reduceRow",
              "reduce": {
                "reducer": "sum"
              },
              "replaceFields": false,
              "binary": {
                "left": "Total Tokens",
                "operator": "*",
                "right": "0.0003"
              }
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Total Tokens"},
              "properties": [
                {"id": "custom.cellOptions", "value": {"type": "color-background"}},
                {"id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    {"value": null, "color": "green"},
                    {"value": 100000, "color": "yellow"},
                    {"value": 500000, "color": "red"}
                  ]
                }}
              ]
            },
            {
              "matcher": {"id": "byName", "options": "Cost (USD)"},
              "properties": [
                {"id": "unit", "value": "currencyUSD"},
                {"id": "decimals", "value": 4}
              ]
            }
          ]
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "job",
          "type": "constant",
          "current": {
            "value": "intellirag",
            "text": "intellirag"
          },
          "hide": 2
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "High Cost Periods",
          "datasource": "Prometheus",
          "enable": true,
          "expr": "(rate(llm_token_count{type=\"output\"}[5m]) * 0.0006 / 1000) > 0.01",
          "iconColor": "red",
          "tagKeys": "cost_spike"
        }
      ]
    }
  }
}
