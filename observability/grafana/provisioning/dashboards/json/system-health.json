{
  "dashboard": {
    "title": "System Health Overview",
    "uid": "system-health-overview",
    "tags": ["intellirag", "overview", "health", "slo"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
        "type": "stat",
        "title": "Service Status",
        "targets": [
          {
            "expr": "up{job=\"intellirag\"}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}}},
              {"type": "value", "options": {"1": {"text": "UP", "color": "green"}}}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "textMode": "value"
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 4, "w": 5, "x": 4, "y": 0},
        "type": "stat",
        "title": "Request Rate (RPS)",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\"}[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "decimals": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 4, "w": 5, "x": 9, "y": 0},
        "type": "stat",
        "title": "P95 Response Time",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m])) by (le))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 2, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 4, "w": 5, "x": 14, "y": 0},
        "type": "stat",
        "title": "Error Rate",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\",status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"intellirag\"}[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 1, "color": "yellow"},
                {"value": 5, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 4, "w": 5, "x": 19, "y": 0},
        "type": "stat",
        "title": "Active Ingestion Jobs",
        "targets": [
          {
            "expr": "sum(ingestion_jobs_active{job=\"intellirag\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 100, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "type": "timeseries",
        "title": "HTTP Traffic Overview",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\"}[5m]))",
            "legendFormat": "Total Requests",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\",status_code=~\"2..\"}[5m]))",
            "legendFormat": "2xx Success",
            "refId": "B"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\",status_code=~\"4..\"}[5m]))",
            "legendFormat": "4xx Client Error",
            "refId": "C"
          },
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\",status_code=~\"5..\"}[5m]))",
            "legendFormat": "5xx Server Error",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "reqps"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "type": "timeseries",
        "title": "LLM Token Usage (Tokens/sec)",
        "targets": [
          {
            "expr": "sum(rate(llm_token_count_total{job=\"intellirag\",type=\"input\"}[5m]))",
            "legendFormat": "Input Tokens/s",
            "refId": "A"
          },
          {
            "expr": "sum(rate(llm_token_count_total{job=\"intellirag\",type=\"output\"}[5m]))",
            "legendFormat": "Output Tokens/s",
            "refId": "B"
          },
          {
            "expr": "sum(rate(llm_token_count_total{job=\"intellirag\"}[5m]))",
            "legendFormat": "Total Tokens/s",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "tps"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "type": "timeseries",
        "title": "Response Time Percentiles",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m])) by (le))",
            "legendFormat": "P50 (median)",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m])) by (le))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m])) by (le))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 0
            },
            "unit": "s"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 9,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "type": "timeseries",
        "title": "Ingestion Pipeline Activity",
        "targets": [
          {
            "expr": "sum(ingestion_jobs_active{job=\"intellirag\",status=\"pending\"})",
            "legendFormat": "Pending",
            "refId": "A"
          },
          {
            "expr": "sum(ingestion_jobs_active{job=\"intellirag\",status=\"processing\"})",
            "legendFormat": "Processing",
            "refId": "B"
          },
          {
            "expr": "sum(rate(ingestion_jobs_total{job=\"intellirag\",status=\"completed\"}[5m]))",
            "legendFormat": "Completed (rate)",
            "refId": "C"
          },
          {
            "expr": "sum(rate(ingestion_jobs_total{job=\"intellirag\",status=\"failed\"}[5m]))",
            "legendFormat": "Failed (rate)",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        },
        "options": {
          "legend": {"displayMode": "list", "placement": "bottom"}
        }
      },
      {
        "id": 10,
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20},
        "type": "stat",
        "title": "Estimated Cost (Hourly)",
        "description": "Based on $0.15/1M input tokens, $0.60/1M output tokens",
        "targets": [
          {
            "expr": "(sum(rate(llm_token_count_total{job=\"intellirag\",type=\"input\"}[1h])) * 0.00015 / 1000 + sum(rate(llm_token_count_total{job=\"intellirag\",type=\"output\"}[1h])) * 0.0006 / 1000) * 3600",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 4,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.05, "color": "yellow"},
                {"value": 0.1, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 11,
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 20},
        "type": "stat",
        "title": "Success Rate (5min)",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"intellirag\",status_code=~\"2..\"}[5m])) / sum(rate(http_requests_total{job=\"intellirag\"}[5m])) * 100",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 95, "color": "yellow"},
                {"value": 99, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 12,
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 20},
        "type": "stat",
        "title": "Average Tokens per Request",
        "targets": [
          {
            "expr": "sum(rate(llm_token_count_total{job=\"intellirag\"}[5m])) / sum(rate(http_requests_total{job=\"intellirag\",endpoint=~\".*/query.*\"}[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "decimals": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "value",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      }
    ]
  }
}
