{
  "dashboard": {
    "title": "Infrastructure",
    "uid": "infrastructure",
    "tags": ["intellirag", "infrastructure", "kubernetes", "resources"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "timeseries",
        "title": "Pod CPU Usage",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"intellirag.*\"}[5m])",
            "legendFormat": "{{pod}} - {{container}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "timeseries",
        "title": "Pod Memory Usage",
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{namespace=\"default\",pod=~\"intellirag.*\"}",
            "legendFormat": "{{pod}} - {{container}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20
            },
            "unit": "bytes"
          }
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "type": "timeseries",
        "title": "Vector DB Operations",
        "targets": [
          {
            "expr": "rate(vector_db_operations_total{job=\"intellirag\"}[5m])",
            "legendFormat": "{{operation}} - {{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80
            },
            "unit": "ops"
          },
          "overrides": [
            {
              "matcher": {"id": "byRegexp", "options": ".*failed.*"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            }
          ]
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "type": "timeseries",
        "title": "Network I/O",
        "targets": [
          {
            "expr": "rate(container_network_receive_bytes_total{namespace=\"default\",pod=~\"intellirag.*\"}[5m])",
            "legendFormat": "RX: {{pod}}",
            "refId": "A"
          },
          {
            "expr": "rate(container_network_transmit_bytes_total{namespace=\"default\",pod=~\"intellirag.*\"}[5m])",
            "legendFormat": "TX: {{pod}}",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "Bps"
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 10, "w": 16, "x": 0, "y": 16},
        "type": "table",
        "title": "Container Restart Count (Last 24h)",
        "targets": [
          {
            "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"default\",pod=~\"intellirag.*\"}[24h])",
            "format": "table",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true},
              "renameByName": {
                "pod": "Pod",
                "container": "Container",
                "namespace": "Namespace",
                "Value": "Restarts (24h)"
              }
            }
          },
          {
            "id": "sortBy",
            "options": {
              "sort": [{"field": "Restarts (24h)", "desc": true}]
            }
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "Restarts (24h)"},
              "properties": [
                {"id": "custom.cellOptions", "value": {"type": "color-background"}},
                {"id": "thresholds", "value": {
                  "mode": "absolute",
                  "steps": [
                    {"value": null, "color": "green"},
                    {"value": 1, "color": "yellow"},
                    {"value": 5, "color": "red"}
                  ]
                }}
              ]
            }
          ]
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 5, "w": 8, "x": 16, "y": 16},
        "type": "stat",
        "title": "Total Pods Running",
        "targets": [
          {
            "expr": "count(kube_pod_status_phase{namespace=\"default\",pod=~\"intellirag.*\",phase=\"Running\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "blue"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "none",
          "textMode": "value"
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 5, "w": 8, "x": 16, "y": 21},
        "type": "stat",
        "title": "Storage Used",
        "description": "Persistent volume usage for application data",
        "targets": [
          {
            "expr": "sum(kubelet_volume_stats_used_bytes{namespace=\"default\",persistentvolumeclaim=~\"intellirag.*\"})",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value",
          "colorMode": "value"
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26},
        "type": "timeseries",
        "title": "API Request Latency Distribution",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.90, rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P90",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P95",
            "refId": "C"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P99",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2
            },
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "P99"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            },
            {
              "matcher": {"id": "byName", "options": "P95"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]
            }
          ]
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "namespace",
          "type": "constant",
          "current": {
            "value": "default",
            "text": "default"
          },
          "hide": 2
        }
      ]
    }
  }
}
