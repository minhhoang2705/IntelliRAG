{
  "dashboard": {
    "title": "Query Performance",
    "uid": "query-performance",
    "tags": ["intellirag", "rag", "query", "performance"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "type": "heatmap",
        "title": "Query Classification Confidence Distribution",
        "targets": [
          {
            "expr": "rate(query_classification_confidence_bucket{job=\"intellirag\"}[5m])",
            "legendFormat": "{{le}}",
            "refId": "A",
            "format": "heatmap"
          }
        ],
        "options": {
          "calculate": true,
          "yAxis": {
            "decimals": 2
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hideFrom": {
                "tooltip": false,
                "viz": false,
                "legend": false
              }
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "type": "bargauge",
        "title": "RAG Stage Duration (Avg P95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rag_query_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "{{stage}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "green"},
                {"value": 0.5, "color": "yellow"},
                {"value": 1, "color": "orange"},
                {"value": 2, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "type": "histogram",
        "title": "Retrieved Documents per Query",
        "targets": [
          {
            "expr": "rate(rag_retrieval_results_bucket{job=\"intellirag\"}[5m])",
            "legendFormat": "{{le}} docs",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        }
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "type": "timeseries",
        "title": "Query Router Decisions (Rate)",
        "targets": [
          {
            "expr": "rate(query_router_decisions_total{job=\"intellirag\"}[5m])",
            "legendFormat": "{{decision}} - {{route}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 20,
              "stacking": {"mode": "normal"}
            },
            "unit": "reqps"
          }
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "type": "stat",
        "title": "Embedding Cache Hit Rate",
        "targets": [
          {
            "expr": "rate(embedding_cache_hits_total{job=\"intellirag\",hit=\"true\"}[5m]) / rate(embedding_cache_hits_total{job=\"intellirag\"}[5m])",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": null, "color": "red"},
                {"value": 0.3, "color": "yellow"},
                {"value": 0.7, "color": "green"}
              ]
            },
            "mappings": []
          }
        },
        "options": {
          "graphMode": "area",
          "textMode": "value_and_name",
          "colorMode": "value"
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
        "type": "timeseries",
        "title": "Query Classification Duration (P50, P95, P99)",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(query_classification_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P50",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(query_classification_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P95",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.99, rate(query_classification_duration_seconds_bucket{job=\"intellirag\"}[5m]))",
            "legendFormat": "P99",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "lineWidth": 2
            },
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "P99"},
              "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]
            }
          ]
        }
      },
      {
        "id": 7,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
        "type": "timeseries",
        "title": "Vector DB Search Operations",
        "targets": [
          {
            "expr": "rate(vector_db_operations_total{job=\"intellirag\",operation=\"search\"}[5m])",
            "legendFormat": "{{status}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 80
            },
            "unit": "ops"
          }
        }
      },
      {
        "id": 8,
        "gridPos": {"h": 6, "w": 24, "x": 0, "y": 24},
        "type": "table",
        "title": "Query Classification Summary (Last Hour)",
        "targets": [
          {
            "expr": "sum by(query_type) (increase(query_classification_total{job=\"intellirag\"}[1h]))",
            "format": "table",
            "refId": "A",
            "instant": true
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {"Time": true},
              "indexByName": {},
              "renameByName": {
                "query_type": "Query Type",
                "Value": "Count"
              }
            }
          }
        ],
        "options": {
          "showHeader": true,
          "sortBy": [{"displayName": "Count", "desc": true}]
        }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "job",
          "type": "constant",
          "current": {
            "value": "intellirag",
            "text": "intellirag"
          },
          "hide": 2
        }
      ]
    }
  }
}
