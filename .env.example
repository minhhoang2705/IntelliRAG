# Application Configuration
APP_NAME=IntelliRAG
APP_VERSION=0.2.0
DEBUG=true
ENVIRONMENT=development

# Google Cloud Storage (GCS) Configuration
GCS_PROJECT_ID=intellirag-project
GCS_BUCKET_NAME=intellirag-raw-documents
GCS_CREDENTIALS_PATH=
GCS_USE_DEFAULT_CREDENTIALS=true

# GCS Storage Settings
GCS_UPLOAD_TIMEOUT=300
GCS_DOWNLOAD_TIMEOUT=300
GCS_MAX_RETRIES=3

# PostgreSQL Configuration (REMOVED - Replaced by Qdrant Payloads)
# All document metadata is now stored in Qdrant payloads alongside vectors.
# See app/models/schemas.py for QdrantPayload schema.

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=default

# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-0.6B

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,csv
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# RAG Configuration
RAG_TOP_K=5
RAG_TEMPERATURE=0.7
RAG_MAX_TOKENS=512
