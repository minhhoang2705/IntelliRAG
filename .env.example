# Application Configuration
APP_NAME=IntelliRAG
APP_VERSION=0.2.0
DEBUG=true
ENVIRONMENT=development

# API Authentication
# Leave empty for development mode (no authentication required)
# For production, generate a secure key: openssl rand -hex 32
API_KEY=b9b864c03c693b7a62c656c1b2fdc2cd8c126e58ce6ce4054aa3e07a5c55f0f9

# Google Cloud Storage (GCS) Configuration
GCS_PROJECT_ID=your-project-id
GCS_BUCKET_NAME=your-bucket-name
GCS_CREDENTIALS_PATH=/path/to/your/service_acount.json
GCS_USE_DEFAULT_CREDENTIALS=true

# GCS Storage Settings
GCS_UPLOAD_TIMEOUT=300
GCS_DOWNLOAD_TIMEOUT=300
GCS_MAX_RETRIES=3

# PostgreSQL Configuration (REMOVED - Replaced by Qdrant Payloads)
# All document metadata is now stored in Qdrant payloads alongside vectors.
# See app/models/schemas.py for QdrantPayload schema.

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=default

# vLLM Configuration
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen3-0.6B

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DEVICE=cpu

# Document Processing Configuration
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,csv
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# RAG Configuration
RAG_TOP_K=5
RAG_TEMPERATURE=0.7
RAG_MAX_TOKENS=512
